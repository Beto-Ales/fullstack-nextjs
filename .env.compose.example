# Copy this file to .env.compose.local and replace with local-only credentials.
# Do not commit .env.compose.local.

# Development PostgreSQL (port 5432 on localhost)
POSTGRES_DEV_USER=app_dev_user
POSTGRES_DEV_PASSWORD=replace-with-local-dev-password
POSTGRES_DEV_DB=fullstack_nextjs
POSTGRES_DEV_PORT=5432

# Test PostgreSQL (port 5433 on localhost)
POSTGRES_TEST_USER=app_test_user
POSTGRES_TEST_PASSWORD=replace-with-local-test-password
POSTGRES_TEST_DB=fullstack_nextjs_test
POSTGRES_TEST_PORT=5433
