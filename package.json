{
  "name": "fullstack-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-postgres-tests.mjs vitest",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node scripts/run-postgres-tests.mjs integration",
    "test:e2e": "node scripts/run-postgres-tests.mjs e2e",
    "test:e2e:pending": "node scripts/run-postgres-tests.mjs e2e-pending",
    "test:verify": "npm run test && npm run test:e2e && npm run test:e2e:pending",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-db-migrate.mjs",
    "db:migrate:dev": "node scripts/run-db-migrate.mjs dev",
    "db:migrate:test": "node scripts/run-postgres-tests.mjs migrate",
    "db:inspect": "node scripts/db-inspection.mjs",
    "db:rehearse": "node scripts/run-postgres-tests.mjs integration postgres-rehearsal.integration.test.ts",
    "staging:rehearse": "node scripts/run-staging-rehearsal.mjs",
    "staging:verify": "npm run typecheck && npm run lint && drizzle-kit check && npm run db:rehearse && npm run staging:rehearse",
    "db:studio": "drizzle-kit studio",
    "admin:create-super-admin": "node scripts/create-super-admin.mjs",
    "academic:generate-sessions": "node scripts/generate-class-sessions.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.44.7",
    "luxon": "^3.7.2",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
